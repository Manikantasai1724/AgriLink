# ─────────────────────────────────────────────
# KrishiSetu Environment Configuration
# ─────────────────────────────────────────────

# ─────────────────────────────────────────────
# 1. Authentication (Local JWT - No Firebase required!)
# ─────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_min_32_characters

# ─────────────────────────────────────────────
# 2. MongoDB Database Connection (REQUIRED)
# ─────────────────────────────────────────────
# Supports MongoDB Atlas or local MongoDB (e.g. mongodb://localhost:27017/krishisetu)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=krishisetu

# ─────────────────────────────────────────────
# 3. Server Port
# ─────────────────────────────────────────────
PORT=5001

# ─────────────────────────────────────────────
# 4. Google Gemini API (OPTIONAL - for AI translation)
# ─────────────────────────────────────────────
# Get a free key at: https://aistudio.google.com/
GOOGLE_GEMINI_API_KEY=your_gemini_api_key

# ─────────────────────────────────────────────
# 5. Email Alerts (OPTIONAL - for email notifications)
# ─────────────────────────────────────────────
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-16-character-gmail-app-password

# ─────────────────────────────────────────────
# 6. Firebase (OPTIONAL - for cloud storage fallback only)
# ─────────────────────────────────────────────
# Authentication no longer requires Firebase!
# You only need these if you want to use Firebase Cloud Storage instead of local /uploads/
# VITE_FIREBASE_API_KEY=your_api_key
# VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=your_project_id
# VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
# VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
# VITE_FIREBASE_APP_ID=your_app_id
# VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id
